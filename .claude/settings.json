{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:motion.dev)",
      "WebFetch(domain:web3forms.com)",
      "WebFetch(domain:vercel.com)",
      "mcp__shadcn",
      "mcp__context7",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
